# === Supabase (compte propre après export) ===
# Récupère ces valeurs dans Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Variables exposées au client (Vite)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# === IA — bascule Gateway Lovable ↔ Gemini direct ===
# "lovable" (par défaut, tant que tu utilises Lovable AI Gateway)
# "gemini"  (après détachement — clé gratuite via https://aistudio.google.com/app/apikey)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optionnel : garder Lovable Gateway comme fallback pendant la transition
LOVABLE_API_KEY=""
